# --- Azure OpenAI Config ---
# Get these from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com/
MODEL_NAME=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_TTS_DEPLOYMENT=tts

# --- Whisper & TTS Config ---
# Deployment name for Whisper (speech-to-text)
WHISPER_DEPLOYMENT_NAME=whisper

# --- Standard OpenAI Config (if used) ---
# If using OpenAI directly instead of Azure
OPENAI_API_KEY=your_openai_api_key_here

# --- Flask Config ---
FLASK_ENV=production
PYTHONPATH=/app

# --- CORS Config ---
# Comma-separated list of allowed origins for CORS
CORS_ORIGINS=http://20.197.8.19,http://20.197.8.19:80,http://20.197.8.19:3000,http://coact-ai.com,https://coact-ai.com,http://localhost,http://localhost:3000

# --- Database Config ---
# Connection string for MongoDB Atlas
MONGODB_URI=mongodb+srv://suyashbalasubramaniam_db_user:RZmQbu4TeqBO8MLN@cluster0.mongodb.net/coact?retryWrites=true&w=majority

# --- Database Connection Pool Config ---
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000

# --- Authentication Config ---
# Change this in production
JWT_SECRET=super-secret-key-change-in-production

# --- SMTP Config (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@coact-ai.com
SMTP_PASS=your_hostinger_email_password
SMTP_ADMIN_EMAIL=team@coact-ai.com
SMTP_SENDER_NAME=CoactAI
