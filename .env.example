# ═══════════════════════════════════════════════════════════════
# CoAct AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# --- AI Model Config (Groq Exclusively) ---
REPORT_MODEL=llama-3.3-70b-versatile
CHAT_MODEL=llama-3.1-8b-instant

# --- STT (Speech-to-Text) Config ---
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Provider API Keys ---
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Flask Config ---
FLASK_ENV=production
PYTHONPATH=/app

# --- CORS Config ---
CORS_ORIGINS=https://coact-ai.com,https://www.coact-ai.com,http://localhost:3000

# --- Database Config ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/coact?retryWrites=true&w=majority

# --- Database Connection Pool Config ---
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000

# --- Authentication Config ---
JWT_SECRET=super-secret-key-change-in-production

# --- SMTP Config (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@coact-ai.com
SMTP_PASS=your_hostinger_email_password
SMTP_ADMIN_EMAIL=team@coact-ai.com
SMTP_SENDER_NAME=CoactAI
