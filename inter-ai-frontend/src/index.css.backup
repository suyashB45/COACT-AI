@import "tailwindcss";

@custom-variant dark (&:is(.dark *));

:root {
  /* ═══════════════════════════════════════════════════════════
     Coact White Theme — White + Logo Blue Accent
     ═══════════════════════════════════════════════════════════ */
  --background: #ffffff;
  --foreground: #121e34;

  --card: #f8fafc;
  --card-foreground: #121e34;

  --popover: #ffffff;
  --popover-foreground: #121e34;

  --primary: #121e34;
  --primary-foreground: #ffffff;

  --secondary: #f1f5f9;
  --secondary-foreground: #121e34;

  --muted: #f1f5f9;
  --muted-foreground: #64748b;

  --accent: #f1f5f9;
  --accent-foreground: #121e34;

  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --success: #22c55e;
  --success-foreground: #ffffff;

  --border: rgba(18, 30, 52, 0.1);
  --input: rgba(18, 30, 52, 0.1);
  --ring: #121e34;

  --radius: 0.5rem;

  --highlight: #e2e8f0;
  --annotation: #64748b;

  --glass-bg: rgba(255, 255, 255, 0.7);
  --glass-border: rgba(18, 30, 52, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(18, 30, 52, 0.05);

  --color-primary-rgb: 18, 30, 52;
}

.dark {
  /* ═══════════════════════════════════════════════════════════
     Coact Black Theme — Pure Black + Logo Blue Accent
     ═══════════════════════════════════════════════════════════ */
  --background: #000000;
  --foreground: #ffffff;

  --card: #0a0a0a;
  --card-foreground: #ffffff;

  --popover: #0a0a0a;
  --popover-foreground: #ffffff;

  --primary: #121e34;
  --primary-foreground: #ffffff;

  --secondary: #111111;
  --secondary-foreground: #ffffff;

  --muted: #111111;
  --muted-foreground: #888888;

  --accent: #111111;
  --accent-foreground: #ffffff;

  --destructive: #ef4444;
  --destructive-foreground: #ffffff;
  --success: #22c55e;
  --success-foreground: #ffffff;

  --border: rgba(255, 255, 255, 0.1);
  --input: rgba(255, 255, 255, 0.1);
  --ring: #121e34;

  --highlight: #1a1a1a;
  --annotation: #888888;

  --glass-bg: rgba(0, 0, 0, 0.7);
  --glass-border: rgba(255, 255, 255, 0.08);
  --glass-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);

  --color-primary-rgb: 18, 30, 52;
}

@theme inline {
  --font-sans: "Inter", "Geist", system-ui, -apple-system, sans-serif;
  --font-display: "Outfit", "Inter", system-ui, sans-serif;
  --font-hand: "Caveat", cursive;

  --color-background: var(--background);
  --color-foreground: var(--foreground);
  --color-card: var(--card);
  --color-card-foreground: var(--card-foreground);
  --color-popover: var(--popover);
  --color-popover-foreground: var(--popover-foreground);
  --color-primary: var(--primary);
  --color-primary-foreground: var(--primary-foreground);
  --color-secondary: var(--secondary);
  --color-secondary-foreground: var(--secondary-foreground);
  --color-muted: var(--muted);
  --color-muted-foreground: var(--muted-foreground);
  --color-accent: var(--accent);
  --color-accent-foreground: var(--accent-foreground);
  --color-destructive: var(--destructive);
  --color-destructive-foreground: var(--destructive-foreground);
  --color-border: var(--border);
  --color-input: var(--input);
  --color-ring: var(--ring);
  --color-highlight: var(--highlight);
  --color-annotation: var(--annotation);

  --radius-sm: calc(var(--radius) - 2px);
  --radius-md: var(--radius);
  --radius-lg: calc(var(--radius) + 4px);
}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }

  body {
    @apply bg-background text-foreground antialiased;
    overflow-x: hidden;
  }

  /* ─── Subtle Noise Texture Overlay ─── */
  body::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 9999;
    pointer-events: none;
    opacity: 0.025;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
  }

  .dark body::before {
    opacity: 0.035;
  }

  /* Grid Pattern (refined) */
  .bg-grid-pattern {
    background-size: 48px 48px;
    background-image: 
      linear-gradient(to right, rgba(255,255,255,0.04) 0.5px, transparent 0.5px),
      linear-gradient(to bottom, rgba(255,255,255,0.04) 0.5px, transparent 0.5px);
    mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse at center, black 30%, transparent 75%);
  }
  
  .glass-panel {
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glass-shadow);
  }

  /* ═══════════════════════════════════════════════════════════
     Legacy Component Compat — keep existing pages working
     ═══════════════════════════════════════════════════════════ */
  .glass {
    @apply bg-[var(--glass-bg)] border border-[var(--glass-border)] backdrop-blur-md shadow-sm;
  }

  .card-ultra-glass {
    @apply bg-card border border-border shadow-sm rounded-xl p-6 transition-all duration-200;
  }
  .card-ultra-glass:hover {
    @apply border-border shadow-md -translate-y-0.5;
  }

  .btn-premium, .btn-ultra-modern {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg font-medium transition-colors;
    background-color: var(--color-primary);
    color: var(--color-primary-foreground);
  }
  .btn-premium:hover, .btn-ultra-modern:hover {
    opacity: 0.9;
  }
  
  .btn-glass {
    @apply inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-lg font-medium border border-border bg-background hover:bg-muted transition-colors;
  }

  .text-ultra-gradient {
    @apply text-foreground font-bold;
  }
  
  .text-gradient-animate {
    @apply text-primary font-bold;
  }
  
  .text-glow {
    text-shadow: none;
  }

  .hero-ultra-modern {
    @apply bg-background;
  }

  /* Legacy color helpers */
  .bg-slate-950 { @apply bg-background; }
  .text-slate-400 { @apply text-muted-foreground; }
  .bg-slate-900\/50, .bg-slate-900 { @apply bg-muted; }
  .border-white\/10 { @apply border-border; }
}

/* ═══════════════════════════════════════════════════════════════
   NukePC-Style Hero Section — Arch, Sunrise Glow, Animations
   ═══════════════════════════════════════════════════════════════ */

/* Sunrise Glow — radial gradient at bottom */
.hero-sunrise-glow {
  position: absolute;
  bottom: -20%;
  left: 50%;
  transform: translateX(-50%);
  width: 120%;
  height: 60%;
  background: radial-gradient(
    ellipse at 50% 100%,
    rgba(255, 81, 35, 0.15) 0%,
    rgba(255, 81, 35, 0.08) 30%,
    rgba(255, 81, 35, 0.02) 50%,
    transparent 70%
  );
  pointer-events: none;
  z-index: 1;
}

/* Arch Container */
.hero-arch-container {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(85vw, 900px);
  height: min(85vw, 900px);
  z-index: 2;
  pointer-events: none;
}

/* Arch Background — semicircle gradient */
.hero-arch {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: radial-gradient(
    ellipse at 50% 100%,
    rgba(255, 81, 35, 0.06) 0%,
    rgba(255, 81, 35, 0.02) 40%,
    transparent 60%
  );
}

/* Arch Border — SVG dashed circle */
.hero-arch-border {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

/* Arch dash animation */
@keyframes arch-dash-rotate {
  0% { stroke-dashoffset: 30; }
  100% { stroke-dashoffset: 660; }
}

.hero-arch-dash-anim {
  animation: arch-dash-rotate 40s linear infinite;
}

/* Hero Image Wrapper */
.hero-img-wrap {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: min(75vw, 800px);
  height: min(75vw, 800px);
  z-index: 3;
  pointer-events: none;
}

.hero-img {
  mask-image: linear-gradient(to top, transparent 0%, black 20%, black 80%, transparent 100%);
  -webkit-mask-image: linear-gradient(to top, transparent 0%, black 20%, black 80%, transparent 100%);
}

/* Hero Image Counter */
.hero-img-counter {
  position: absolute;
  bottom: 15%;
  left: 50%;
  transform: translateX(-50%);
  z-index: 5;
}

.hero-img-counter-num {
  font-size: 4rem;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.08);
  line-height: 1;
  font-family: var(--font-display);
}

.hero-img-counter-pct {
  font-size: 2rem;
  vertical-align: super;
}

/* Top / Bottom fade overlays */
.hero-top-fade {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 120px;
  background: linear-gradient(to bottom, #000000, transparent);
  z-index: 5;
  pointer-events: none;
}

.hero-bottom-fade {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200px;
  background: linear-gradient(to top, #000000, transparent);
  z-index: 5;
  pointer-events: none;
}

/* Hero Animation Classes */
@keyframes hero-fade-up {
  0% { opacity: 0; transform: translateY(30px); }
  100% { opacity: 1; transform: translateY(0); }
}

.hero-anim-heading {
  animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;
}

.hero-anim-subtext {
  animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.4s both;
}

.hero-anim-buttons {
  animation: hero-fade-up 0.8s cubic-bezier(0.16, 1, 0.3, 1) 0.6s both;
}

/* Hero Primary Button */
.hero-btn-primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 8px;
  background: #ffffff;
  color: #000000;
  font-weight: 600;
  font-size: 15px;
  transition: all 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.2);
}

.hero-btn-primary:hover {
  background: rgba(255, 255, 255, 0.9);
  transform: translateY(-1px);
  box-shadow: 0 8px 30px rgba(255, 81, 35, 0.2);
}

.hero-btn-icon {
  display: flex;
  align-items: center;
}

/* Hero Secondary Button */
.hero-btn-secondary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 12px 28px;
  border-radius: 8px;
  background: transparent;
  color: #ffffff;
  font-weight: 500;
  font-size: 15px;
  transition: all 0.3s ease;
  border: 1px solid rgba(255, 255, 255, 0.15);
}

.hero-btn-secondary:hover {
  background: rgba(255, 255, 255, 0.05);
  border-color: rgba(255, 255, 255, 0.3);
}

/* ═══════════════════════════════════════════════════════════════
   Category Cards (NukePC-style)
   ═══════════════════════════════════════════════════════════════ */
.category-card {
  position: relative;
  background: #000000;
  border: 0.5px solid #FF5123;
  border-radius: 12px;
  overflow: hidden;
  height: 220px;
  transition: all 0.4s ease;
}

@media (min-width: 640px) {
  .category-card {
    height: 300px;
  }
}

@media (min-width: 1024px) {
  .category-card {
    height: 350px;
  }
}

.category-card:hover {
  border-color: #FF5123;
  box-shadow: 0 0 30px rgba(255, 81, 35, 0.15);
  transform: translateY(-2px);
}

.category-card-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.6;
  transition: opacity 0.4s ease, transform 0.6s ease;
}

.category-card:hover .category-card-img {
  opacity: 0.75;
  transform: scale(1.05);
}

.category-card-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.95) 0%,
    rgba(0, 0, 0, 0.4) 50%,
    rgba(0, 0, 0, 0.1) 100%
  );
}

.category-card-content {
  position: relative;
  z-index: 2;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  padding: 16px;
}

.category-card-title {
  font-weight: 700;
  color: #ffffff;
  font-size: 1.1rem;
  line-height: 1.2;
}

@media (min-width: 640px) {
  .category-card-title {
    font-size: 1.35rem;
  }
}

.category-card-glow {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 100px;
  background: radial-gradient(
    ellipse at 50% 100%,
    rgba(255, 81, 35, 0.2) 0%,
    transparent 70%
  );
  filter: blur(30px);
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════
   Section Glow Effects
   ═══════════════════════════════════════════════════════════════ */
.section-glow {
  position: relative;
}

.section-glow::before {
  content: '';
  position: absolute;
  top: -100px;
  left: 50%;
  transform: translateX(-50%);
  width: 600px;
  height: 300px;
  background: radial-gradient(
    ellipse at center,
    rgba(255, 81, 35, 0.06) 0%,
    transparent 70%
  );
  pointer-events: none;
}

/* ═══════════════════════════════════════════════════════════════
   Video Call Mode — Minimal UI (preserved)
   ═══════════════════════════════════════════════════════════════ */
.mirror {
  transform: scaleX(-1);
}

.audio-bar-vc {
  animation: audio-bar-vc-bounce 0.5s ease-in-out infinite alternate;
  background: rgba(255,255,255,0.8);
  min-height: 4px;
}

@keyframes audio-bar-vc-bounce {
  0% { height: 20%; opacity: 0.5; }
  100% { height: 90%; opacity: 1; }
}

/* ═══════════════════════════════════════════════════════════════
   Conversation AI UI - Clean Professional View (preserved)
   ═══════════════════════════════════════════════════════════════ */
.ai-indicator-idle {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--color-muted);
  border: 2px solid var(--color-border);
  transition: all 0.3s ease;
}

.ai-indicator-speaking {
  width: 60px;
  height: 60px;
  border-radius: 50%;
  background: var(--color-primary);
  box-shadow: 0 0 15px rgba(255, 81, 35, 0.4);
  animation: pulse-soft 2s infinite;
}

@keyframes pulse-soft {
  0%, 100% { transform: scale(1); opacity: 0.9; }
  50% { transform: scale(1.05); opacity: 1; }
}

.glass-dock {
  @apply bg-background/90 backdrop-blur-md border border-border shadow-sm;
}

/* ═══════════════════════════════════════════════════════════════
   Smooth Scroll & Marquee
   ═══════════════════════════════════════════════════════════════ */
html {
  scroll-behavior: smooth;
}

@keyframes marquee {
  0% { transform: translateX(0); }
  100% { transform: translateX(-50%); }
}

.animate-marquee {
  animation: marquee 30s linear infinite;
}

.animate-marquee:hover {
  animation-play-state: paused;
}

/* Animated counter shimmer */
@keyframes shimmer {
  0% { background-position: -200% center; }
  100% { background-position: 200% center; }
}

.stat-shimmer {
  background: linear-gradient(90deg, #FF5123 0%, #ff8c66 50%, #FF5123 100%);
  background-size: 200% auto;
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  animation: shimmer 3s ease-in-out infinite;
}

/* ═══════════════════════════════════════════════════════════════
   Hero Product Mockup — Perspective Glow (preserved)
   ═══════════════════════════════════════════════════════════════ */
.hero-mockup {
  perspective: 1200px;
}

.hero-mockup-inner {
  transform: rotateX(2deg) rotateY(0deg);
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}

.hero-mockup:hover .hero-mockup-inner {
  transform: rotateX(0deg) rotateY(0deg);
}

.hero-mockup-glow {
  background: radial-gradient(
    ellipse at 50% 100%,
    rgba(255, 81, 35, 0.25) 0%,
    transparent 60%
  );
}

/* ═══════════════════════════════════════════════════════════════
   Status Indicator Pulse
   ═══════════════════════════════════════════════════════════════ */
@keyframes status-pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

.status-dot {
  animation: status-pulse 2s ease-in-out infinite;
}

/* ═══════════════════════════════════════════════════════════════
   Trust Logo Styles
   ═══════════════════════════════════════════════════════════════ */
.trust-logo-text {
  font-weight: 700;
  letter-spacing: -0.02em;
  white-space: nowrap;
}

/* ═══════════════════════════════════════════════════════════════
   Dark Section Dividers & Glowing Borders
   ═══════════════════════════════════════════════════════════════ */
.nuke-section {
  position: relative;
  background: #000000;
  overflow: hidden;
}

.nuke-section-border {
  border-top: 1px solid rgba(255, 255, 255, 0.06);
}

/* Orange accent underline for headings */
.accent-underline {
  position: relative;
  display: inline-block;
}

.accent-underline::after {
  content: '';
  position: absolute;
  bottom: -4px;
  left: 0;
  width: 60px;
  height: 3px;
  background: #FF5123;
  border-radius: 2px;
}

/* Glowing orange badge */
.nuke-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 12px;
  border-radius: 9999px;
  background: rgba(255, 81, 35, 0.1);
  border: 1px solid rgba(255, 81, 35, 0.2);
  color: #FF5123;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

/* ═══════════════════════════════════════════════════════════════
   Feature Cards — Dark Glassmorphism
   ═══════════════════════════════════════════════════════════════ */
.feature-card-dark {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  padding: 32px;
  transition: all 0.4s ease;
  position: relative;
  overflow: hidden;
}

.feature-card-dark:hover {
  border-color: rgba(255, 81, 35, 0.3);
  background: rgba(255, 255, 255, 0.04);
  box-shadow: 0 0 40px rgba(255, 81, 35, 0.06);
}

.feature-card-dark::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(
    90deg,
    transparent,
    rgba(255, 81, 35, 0.3),
    transparent
  );
  opacity: 0;
  transition: opacity 0.4s ease;
}

.feature-card-dark:hover::before {
  opacity: 1;
}

/* ═══════════════════════════════════════════════════════════════
   Pricing Card Variants
   ═══════════════════════════════════════════════════════════════ */
.pricing-card-dark {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 12px;
  padding: 32px;
  transition: all 0.3s ease;
}

.pricing-card-dark:hover {
  border-color: rgba(255, 255, 255, 0.15);
}

.pricing-card-popular {
  background: linear-gradient(135deg, rgba(255, 81, 35, 0.08), rgba(255, 81, 35, 0.02));
  border: 1px solid rgba(255, 81, 35, 0.3);
  border-radius: 12px;
  padding: 32px;
  position: relative;
  transition: all 0.3s ease;
  box-shadow: 0 0 40px rgba(255, 81, 35, 0.08);
}

.pricing-card-popular:hover {
  box-shadow: 0 0 60px rgba(255, 81, 35, 0.12);
  border-color: rgba(255, 81, 35, 0.4);
}

/* ═══════════════════════════════════════════════════════════════
   FAQ Accordion — Dark Theme
   ═══════════════════════════════════════════════════════════════ */
.faq-item-dark {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 12px;
  overflow: hidden;
  transition: all 0.3s ease;
}

.faq-item-dark:hover {
  border-color: rgba(255, 255, 255, 0.12);
}

/* ═══════════════════════════════════════════════════════════════
   Loading counter animation
   ═══════════════════════════════════════════════════════════════ */
@keyframes counter-up {
  0% { opacity: 0; }
  100% { opacity: 1; }
}

/* ═══════════════════════════════════════════════════════════════
   Testimonial star in orange
   ═══════════════════════════════════════════════════════════════ */
.star-orange {
  fill: #FF5123;
  color: #FF5123;
}

.star-empty {
  fill: transparent;
  color: rgba(255, 255, 255, 0.15);
}

/* ═══════════════════════════════════════════════════════════════
   Scrollbar — Dark Premium
   ═══════════════════════════════════════════════════════════════ */
::-webkit-scrollbar {
  width: 6px;
}

::-webkit-scrollbar-track {
  background: #000000;
}

::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.15);
  border-radius: 3px;
}

::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.25);
}
