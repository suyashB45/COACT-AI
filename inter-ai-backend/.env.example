# ═══════════════════════════════════════════════════════════════
# CoAct AI — Environment Configuration
# ═══════════════════════════════════════════════════════════════

# --- AI Model Config (Groq Exclusively) ---
REPORT_MODEL=openai/gpt-oss-120b
CHAT_MODEL=openai/gpt-oss-20b

# --- STT (Speech-to-Text) Config ---
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# --- Provider API Keys ---
GROQ_API_KEY=your_groq_api_key_here
SARVAM_API_KEY=your_sarvam_api_key_here

# --- Flask Config ---
FLASK_ENV=production
PYTHONPATH=/app

# --- CORS Config ---
CORS_ORIGINS=*
VITE_API_URL=

# --- Database Config ---
# For MongoDB Atlas (NoSQL) connection:
MONGODB_URI=mongodb+srv://suyashbalasubramaniam_db_user:RZmQbu4TeqBO8MLN@cluster0.mongodb.net/coact?retryWrites=true&w=majority

# --- Database Connection Pool Config ---
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=30000

# --- Authentication Config ---
JWT_SECRET=super-secret-key-change-in-production

# --- SMTP Config (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@coact-ai.com
SMTP_PASS=your_smtp_password_here
SMTP_ADMIN_EMAIL=team@coact-ai.com
SMTP_SENDER_NAME=CoactAI

# --- LangSmith API Monitoring ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=coactai
