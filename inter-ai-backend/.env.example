# --- Groq & OpenAI API Setup Config ---
USE_LOCAL_AI=false
GROQ_API_KEY=your_groq_api_key_here
GROQ_OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=llama-3.3-70b-versatile
CHAT_MODEL_NAME=llama-3.1-8b-instant

# --- Whisper & Piper (TTS/STT) Config ---
PIPER_MODEL_PATH=d:\GH INDUCTION\COACT PROJECT\piper_tts\piper\en_US-joe-medium.onnx
PIPER_MODEL_PATH_BOY=d:\GH INDUCTION\COACT PROJECT\piper_tts\piper\en_US-joe-medium.onnx
PIPER_MODEL_PATH_GIRL=d:\GH INDUCTION\COACT PROJECT\piper_tts\piper\en_US-kristin-medium.onnx
PIPER_CMD=d:\GH INDUCTION\COACT PROJECT\piper_tts\piper\piper.exe

# --- Flask Config ---
FLASK_ENV=production
PYTHONPATH=/app

# --- CORS Config ---
CORS_ORIGINS=*
VITE_API_URL=

# --- Database Config ---
# For MongoDB Atlas (NoSQL) connection:
MONGODB_URI=mongodb+srv://suyashbalasubramaniam_db_user:RZmQbu4TeqBO8MLN@cluster0.mongodb.net/coact?retryWrites=true&w=majority

# --- SMTP Config (Hostinger) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=team@coact-ai.com
SMTP_PASS=your_smtp_password_here
SMTP_ADMIN_EMAIL=team@coact-ai.com
SMTP_SENDER_NAME=CoactAI

# --- LangSmith API Monitoring ---
# Sign up at https://smith.langchain.com and create an API key
# When set, all LLM calls are automatically traced (tokens, latency, cost)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=coactai
